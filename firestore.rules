rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/campingGroups/$(groupId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /campingGroups/{groupId} {
      // Invite-code lookup is intentionally limited to authenticated users.
      // All group data below remains member-only.
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isMember(groupId)
        && resource.data.owner == request.auth.uid;

      match /members/{userId} {
        allow read: if isMember(groupId);
        allow create: if signedIn() && request.auth.uid == userId;
        allow update, delete: if isMember(groupId)
          && get(/databases/$(database)/documents/campingGroups/$(groupId)).data.owner == request.auth.uid;
      }

      match /{collectionName}/{documentId} {
        allow read, create, update, delete: if isMember(groupId);
      }

      match /checklists/{checklistId}/items/{itemId} {
        allow read, create, update, delete: if isMember(groupId);
      }
    }
  }
}
